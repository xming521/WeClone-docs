{
    "cleanUrls": true,
    "redirects": [
        {
            "source": "/:page(what-is-weclone|FAQ|community-resources){.html}?",
            "destination": "/docs/introduce/:page",
            "permanent": true
        },
        {
            "source": "/deploy/override-settings{.html}?",
            "destination": "/docs/config/weclone-config",
            "permanent": true
        },
        {
            "source": "/:section(introduce|deploy|chatbot|config)/:path*{.html}?",
            "destination": "/docs/:section/:path*",
            "permanent": true
        },
        {
            "source": "/:lang(zh|en)/deploy/override-settings{.html}?",
            "destination": "/:lang/docs/config/weclone-config",
            "permanent": true
        },
        {
            "source": "/:lang(zh|en)/docs/deploy/override-settings{.html}?",
            "destination": "/:lang/docs/config/weclone-config",
            "permanent": true
        },
        {
            "source": "/:lang(zh|en)/:section(introduce|deploy|chatbot|config)/:path*{.html}?",
            "destination": "/:lang/docs/:section/:path*",
            "permanent": true
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "header",
                    "key": "accept-language",
                    "value": "(?=.*zh).*"
                }
            ],
            "destination": "/zh/",
            "permanent": false
        },
        {
            "source": "/",
            "destination": "/en/",
            "permanent": false
        },
        {
            "source": "/docs/:path*{.html}?",
            "has": [
                {
                    "type": "header",
                    "key": "accept-language",
                    "value": "(?=.*zh).*"
                }
            ],
            "destination": "/zh/docs/:path*",
            "permanent": false
        },
        {
            "source": "/docs/:path*{.html}?",
            "destination": "/en/docs/:path*",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/zh/(.*)",
            "destination": "/zh/$1"
        },
        {
            "source": "/en/(.*)",
            "destination": "/en/$1"
        }
    ]
}
