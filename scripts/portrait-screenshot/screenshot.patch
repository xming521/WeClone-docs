+   with heavier, larger label type. */
+:root[data-screenshot] {
+  --text-node-root: 700 22px/28px var(--font-sans);
+  --text-node-dim: 700 20px/26px var(--font-sans);
+  --text-node-section: 600 18px/23px var(--font-sans);
+}
+
+:root[data-screenshot] :is(.topbar, .review-bar, .canvas-toolbar, .canvas-help) {
+  visibility: hidden;
+}
diff --git a/web/src/screenshot.ts b/web/src/screenshot.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e20f7a72d099d3ba75ecd1844d866df5ec7041e3
--- /dev/null
+++ b/web/src/screenshot.ts
@@ -0,0 +1,19 @@
+// `?screenshot` in the address opens the portrait map alone, for the README picture: no page around it and no
+// intro. `labels` draws its labels that many times their size. The recorder (scripts/portrait-screenshot/record.mjs
+// in WeClone-docs) steps it frame by frame through `window.atlasCapture`.
+import type { AtlasCapture, AtlasOptions } from './atlas/atlasEngine';
+import './screenshot.css';
+
+declare global {
+  interface Window {
+    atlasCapture?: AtlasCapture;
+  }
+}
+
+const query = new URLSearchParams(window.location.search);
+
+export const SCREENSHOT: AtlasOptions['screenshot'] = query.has('screenshot')
+  ? { labels: Number(query.get('labels') ?? 1) }
+  : undefined;
+
+if (SCREENSHOT) document.documentElement.setAttribute('data-screenshot', '');
